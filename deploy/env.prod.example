# /opt/pagecite/.env on the server (P5B). Copy, fill in, then: sudo chmod 600 /opt/pagecite/.env
# This file lives ONLY on the server. Never commit the filled-in copy.
# There are NO AWS keys here on purpose: S3 access comes from the EC2 instance role (IMDSv2).

# --- Site -------------------------------------------------------------------------------------------
SITE_ADDRESS=pagecite.duckdns.org
# The public demo's ask-only key (create it with `pc exec api flask --app apps.api create-ask-key`).
# Empty = the site shows the full console (paste-your-key mode) instead of the demo.
DEMO_ASK_KEY=

# --- App ----------------------------------------------------------------------------------------------
LOG_LEVEL=INFO
SECRET_KEY=<64 random characters: openssl rand -hex 32>

# --- MySQL (container; data in the mysql-data volume) ---------------------------------------------------
MYSQL_DATABASE=pagecite
MYSQL_USER=pagecite
MYSQL_PASSWORD=<openssl rand -hex 24>
MYSQL_ROOT_PASSWORD=<openssl rand -hex 24>

# --- S3 (instance role; no keys) ------------------------------------------------------------------------
S3_BUCKET=<your bucket, e.g. pagecite-prod-k3x9q2>
AWS_REGION=ap-south-1
PRESIGN_EXPIRES_SECONDS=900

# --- OpenAI (the separate pagecite-prod project key, with its own monthly budget) ------------------------
OPENAI_API_KEY=<pagecite-prod project key>
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_FAST_MODEL=gpt-5.4-nano-2026-03-17

# --- Public demo limits (apps/api/limits.py) -----------------------------------------------------------
ASK_RATE_PER_MINUTE=10
ASK_RATE_PER_DAY=20
DAILY_SPEND_CAP_USD=0.50
SPEND_RESERVE_USD=0.01
ASK_MAX_CHARS=500
