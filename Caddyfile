# One Caddyfile for dev and prod.
#   dev  (docker-compose.yml mounts this file): SITE_ADDRESS unset -> plain HTTP on :80, no demo key.
#   prod (baked into the Caddy image, docker-compose.prod.yml): SITE_ADDRESS=pagecite.duckdns.org ->
#        automatic HTTPS (Let's Encrypt via HTTP-01 on :80), certificates kept in the caddy-data volume.
# Moving to a real domain later is a change of SITE_ADDRESS only.
{$SITE_ADDRESS::80} {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# The public demo's ask-only key (P5B), from the server's .env: never in the bundle, the images or
	# GitHub. Empty (dev, or before it is configured) -> the web app shows the full console instead.
	handle /config.json {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"demoKey":"{$DEMO_ASK_KEY}"}` 200
	}

	# API: strip the /api prefix so routes match docs/specs.md §6 (/batches, /documents/...).
	handle_path /api/* {
		# Uploads go straight to S3 with presigned URLs, so API bodies are small JSON.
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000 {
			# SSE (/ask): send every event as soon as the API writes it.
			flush_interval -1
			# Close idle upstream connections BEFORE gunicorn does (--keep-alive 75, apps/api/Dockerfile).
			# With Caddy's default (2 min) against gunicorn's default (2 s), a request could be sent on a
			# connection gunicorn was closing: reset -> 502, and a POST is not retried (found by the P5
			# load test; tests/unit/test_proxy_keepalive.py keeps the order).
			transport http {
				keepalive 30s
			}
		}
	}

	# Web console: built Vite app (apps/web/dist; in prod baked into the Caddy image).
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
